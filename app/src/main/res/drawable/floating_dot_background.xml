<?xml version="1.0" encoding="utf-8"?>
<!-- J-AI-mes Butler Button - Elegant navy circle with gold accent ring -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer glow ring (gold, subtle) -->
    <item
        android:top="1dp"
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="@color/butler_button_gold" />
            <size
                android:width="96dp"
                android:height="96dp" />
        </shape>
    </item>

    <!-- Main circle (deep navy) -->
    <item
        android:top="3dp"
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/primary" />
            <size
                android:width="90dp"
                android:height="90dp" />
        </shape>
    </item>

    <!-- Inner accent ring (thin gold line for depth) -->
    <item
        android:top="6dp"
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp">
        <shape android:shape="oval">
            <stroke
                android:width="0.5dp"
                android:color="@color/accent_gold_light" />
        </shape>
    </item>

</layer-list>
