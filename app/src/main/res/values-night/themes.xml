<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- J-AI-mes night theme - same as base since the brand IS dark -->
    <style name="Base.Theme.AIRescueRing" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color - Deep Navy -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        
        <!-- Secondary color - Champagne Gold -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        
        <!-- Dark surfaces -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        
        <!-- On colors -->
        <item name="colorOnPrimary">@color/accent_gold</item>
        <item name="colorOnSecondary">@color/primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/primary_dark</item>
    </style>
</resources>