<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - J-AI-mes Premium Dark -->
    <style name="Base.Theme.AIRescueRing" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color - Deep Navy -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        
        <!-- Secondary color - Champagne Gold -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        
        <!-- Background and surface - Dark butler aesthetic -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        
        <!-- On colors - Warm white on dark -->
        <item name="colorOnPrimary">@color/accent_gold</item>
        <item name="colorOnSecondary">@color/primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        
        <!-- Status bar - Deep navy for premium feel -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/primary_dark</item>
    </style>

    <style name="Theme.AIRescueRing" parent="Base.Theme.AIRescueRing" />

    <!-- Transparent theme for AI Helper Activity -->
    <style name="Theme.AIRescueRing.Transparent" parent="Theme.AIRescueRing">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>
    
    <!-- Primary button style - Gold on Navy -->
    <style name="Widget.AIRescueRing.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/accent_gold</item>
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">12dp</item>
    </style>
    
    <!-- Secondary button style - Gold outline -->
    <style name="Widget.AIRescueRing.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/accent_gold</item>
        <item name="android:textColor">@color/accent_gold</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>